true\n        music.playTone(1500, 30)\n    })\n})\n\n// ===== B 버튼: 그림자 흐리게 (3초 안전) =====\n// 타임 어택: 시간 3초 / 나머지: 코인 3개\nlet safeUntil = 0\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (mode == 1) {\n        if (timeLeft < 4000) {\n            player.sayText(\"No time!\", 600)\n            return\n        }\n        timeLeft -= 3000\n    } else {\n        if (info.score() < 3) {\n            player.sayText(\"3 coins!\", 600)\n            return\n        }\n        info.changeScoreBy(-3)\n    }\n    safeUntil = game.runtime() + 3000\n    scene.cameraShake(4, 200)\n    player.startEffect(effects.rings, 300)\n    control.runInParallel(function () {\n        music.playTone(100, 200)\n    })\n})\n\n// ===== 그림자 유령 =====\nlet ghostSpeed = 0.75   // 그림자 속도 (1 = 나와 같은 속도)\nlet xs: number[] = []\nlet ys: number[] = []\nlet base = 0\nlet total = 0\nlet ghosts: Sprite[] = []\nlet pos: number[] = []\nlet born: number[] = []\nlet active: boolean[] = []\n\nfunction spawnGhost() {\n    let g = sprites.create(player.image.clone(), SpriteKind.Enemy)\n    g.image.replace(5, 12)\n    g.setFlag(SpriteFlag.Ghost, true)\n    let start = Math.max(base, total - 1 - 60 * (ghosts.length + 1))\n    g.setPosition(xs[start - base], ys[start - base])\n    ghosts.push(g)\n    pos.push(start)\n    born.push(game.runtime())\n    active.push(false)\n    player.sayText(\"Ghost!\", 800)\n    control.runInParallel(function () {\n        music.playTone(196, 300)\n    })\n}\n\ngame.onUpdateInterval(50, function () {\n    xs.push(player.x)\n    ys.push(player.y)\n    total++\n    let now = game.runtime()\n    let need = total - 1 - 60 * (ghosts.length + 1)\n    for (let i = 0; i < ghosts.length; i++) {\n        pos[i] = Math.min(pos[i] + ghostSpeed, total - 1)\n        let idx = Math.floor(pos[i]) - base\n        ghosts[i].setPosition(xs[idx], ys[idx])\n        need = Math.min(need, Math.floor(pos[i]))\n        let danger = now - born[i] > 1500 && now > safeUntil\n        if (danger != active[i]) {\n            active[i] = danger\n            ghosts[i].setFlag(SpriteFlag.Ghost, !danger)\n            if (danger) {\n                ghosts[i].image.replace(12, 10)\n            } else {\n                ghosts[i].image.replace(10, 12)\n            }\n        }\n    }\n    while (base < need - 2) {\n        xs.shift()\n        ys.shift()\n        base++\n    }\n})\n\ngame.onUpdateInterval(10000, function () {\n    spawnGhost()\n})\n\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Enemy, function (sprite, otherSprite) {\n    endGame(false, \"CAUGHT!\")\n})"]]}]}]},{"timestamp":1795002817528,"editorVersion":"4.1.28","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":2163,"length1":56,"diffs":[[1,"let limits = [50000, 40000, 30000, 27000, 25000, 23000]\n"]]},{"start1":2220,"length1":72,"diffs":[[1,""]]},{"start1":2689,"length1":22,"diffs":[[1,""]]},{"start1":6539,"length1":4821,"diffs":[[1,"makeWall(15, 60,"]]}]}]},{"timestamp":1795003384230,"editorVersion":"4.1.28","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":2163,"length1":56,"diffs":[[1,"let limits = [30000, 25000, 20000, 17000, 15000, 14000]\n"]]},{"start1":2220,"length1":74,"diffs":[[1,"// ===== 그림자가 나오는 간격 (스피드런은 4초, 나머지는 10초) =====\nlet ghostEvery = 10000\n"]]},{"start1":2761,"length1":22,"diffs":[[1,"    ghostEvery = 4000\n"]]},{"start1":9686,"length1":81,"diffs":[[1,"let lastGhost = game.runtime()\n// 스피드런: 시작 1.5초 뒤 첫 유령 등장\nif (mode == 4) {\n    lastGhost = game.runtime() - (ghostEvery - 1500)\n}\n"]]}]}]},{"timestamp":1795004317711,"editorVersion":"4.1.28","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":2220,"length1":107,"diffs":[[1,""]]},{"start1":2676,"length1":129,"diffs":[[1,"    game.splash(\"STAGE \" + stage, \"Collect \" + goal + \" coins!\")\n"]]},{"start1":7756,"length1":18,"diffs":[[1,""]]},{"start1":7931,"length1":77,"diffs":[[1,""]]},{"start1":8233,"length1":412,"diffs":[[1,""]]}]}]},{"timestamp":1795004838984